% Do not wrap tabularx in another environment: tabularx must see its own literal
% \end{tabularx} while collecting the body. Plain tabular columns avoid that
% body-scanning restriction and are sufficient for these short reference tables.
\newenvironment{keywordparameters}{%
  \subsection*{Parameters}
  \begin{tabular}{@{}p{0.20\linewidth}p{0.15\linewidth}p{0.59\linewidth}@{}}
  \toprule
  \textbf{Parameter} & \textbf{Status} & \textbf{Meaning} \\
  \midrule
}{%
  \bottomrule
  \end{tabular}
}

\newenvironment{keyworddata}{%
  \subsection*{Data lines}
  \begin{tabular}{@{}p{0.27\linewidth}p{0.67\linewidth}@{}}
  \toprule
  \textbf{Entry} & \textbf{Meaning} \\
  \midrule
}{%
  \bottomrule
  \end{tabular}
}

